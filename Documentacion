# servidor-mcp/servidor_simple.py

print("🔧 Iniciando servidor MCP simple...")

class ServidorBasico:
    def __init__(self):
        print("✅ Servidor creado")
        self.herramientas = {}
        self.crear_herramientas()

    def crear_herramientas(self):
        """Crea nuestras herramientas"""
        print("🛠️ Creando herramientas...")
        
        def buscar_articulos(tema):
            """Busca artículos sobre un tema"""
            print(f"🔍 Buscando artículos sobre: {tema}")
            
            # Artículos simulados (por ahora)
            articulos = [
                {
                    "titulo": f"Introducción a {tema}",
                    "autor": "Dr. García",
                    "resumen": f"Este artículo explica los conceptos básicos de {tema}.",
                    "año": 2024
                },
                {
                    "titulo": f"Avances en {tema}",
                    "autor": "Prof. López",
                    "resumen": f"Exploramos los últimos avances en el campo de {tema}.",
                    "año": 2023
                },
                {
                    "titulo": f"Aplicaciones prácticas de {tema}",
                    "autor": "Dra. Martínez",
                    "resumen": f"Casos de uso reales donde {tema} ha demostrado ser efectivo.",
                    "año": 2024
                }
            ]
            
            print(f"✅ Encontrados {len(articulos)} artículos")
            return articulos

        # Guardar la herramienta
        self.herramientas["buscar_articulos"] = buscar_articulos
        print("✅ Herramienta 'buscar_articulos' creada")

    def usar_herramienta(self, nombre, parametros):
        """Usa una herramienta específica"""
        print(f"🔧 Usando herramienta: {nombre}")
        
        if nombre in self.herramientas:
            herramienta = self.herramientas[nombre]
            resultado = herramienta(parametros)
            print(f"✅ Herramienta ejecutada correctamente")
            return resultado
        else:
            print(f"❌ Herramienta '{nombre}' no encontrada")
            return None

    def listar_herramientas(self):
        """Muestra qué herramientas tenemos"""
        print("📋 Herramientas disponibles:")
        for nombre in self.herramientas.keys():
            print(f"  - {nombre}")
        return list(self.herramientas.keys())

# Probemos nuestro servidor
def probar_servidor():
    print("🚀 PROBANDO NUESTRO SERVIDOR")
    print("=" * 40)
    
    # Crear el servidor
    servidor = ServidorBasico()
    
    # Ver qué herramientas tiene
    servidor.listar_herramientas()
    
    # Usar la herramienta
    print("\n🔍 Probando búsqueda...")
    resultados = servidor.usar_herramienta("buscar_articulos", "inteligencia artificial")
    
    # Mostrar resultados
    print("\n📚 RESULTADOS:")
    for i, articulo in enumerate(resultados, 1):
        print(f"\n{i}. {articulo['titulo']}")
        print(f"   Autor: {articulo['autor']}")
        print(f"   Año: {articulo['año']}")
        print(f"   Resumen: {articulo['resumen']}")

# Si ejecutamos este archivo directamente, probar el servidor
if __name__ == "__main__":
    probar_servidor()
